# ===========================================================================
# TezTaxiTop - environment configuration template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ===========================================================================

# --- Django core -----------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) -------------------------------------------------
# Option A: single URL
DATABASE_URL=postgres://taxitop:taxitop@localhost:5432/taxitop
# Option B: discrete variables (used when DATABASE_URL is empty)
POSTGRES_DB=taxitop
POSTGRES_USER=taxitop
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=https://your-mini-app.example.com

# --- Payment providers -----------------------------------------------------
PAYMENT_CLICK_MERCHANT_ID=
PAYMENT_CLICK_SECRET_KEY=
PAYMENT_CLICK_SERVICE_TOKEN=
PAYMENT_PAYME_MERCHANT_ID=
PAYMENT_PAYME_SECRET_KEY=
PAYMENT_UZUM_MERCHANT_KEY=
PAYMENT_UZUM_SECRET_KEY=

# --- Business rules --------------------------------------------------------
TRIP_REQUIRES_ACTIVE_SUBSCRIPTION=True
TRIP_REQUIRES_VERIFIED_DRIVER=True
TRIP_REQUIRES_VERIFIED_VEHICLE=True
SUBSCRIPTION_EXPIRING_WARNING_DAYS=3
PASSENGER_REQUEST_EXPIRY_HOURS=6
TRIP_DEPARTURE_GRACE_MINUTES=60
MATCHING_TIME_WINDOW_HOURS=6
MATCHING_MAX_RESULTS=20

# --- API -------------------------------------------------------------------
API_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100
API_THROTTLE_RATE_ANON=30/min
API_THROTTLE_RATE_USER=120/min
API_THROTTLE_RATE_BURST=20/s
